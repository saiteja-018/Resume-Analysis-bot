# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# TokenRouter API Key
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here

# AI Model (default: z-ai/glm-5.3-free)
AI_MODEL=z-ai/glm-5.3-free

# Max resume text length sent to AI (characters)
MAX_RESUME_LENGTH=8000

# Max JD text length sent to AI (characters)
MAX_JD_LENGTH=4000

# Session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600
