# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GLM API Key
GLM_API_KEY=your_glm_api_key_here

# Groq API Key (optional)
GROQ_API_KEY=your_groq_api_key_here

# AI Model on Groq (default: qwen/qwen3.8-27b or llama-3.3-70b-versatile)
AI_MODEL=qwen/qwen3.8-27b

# Max resume text length sent to AI (characters)
MAX_RESUME_LENGTH=8000

# Max JD text length sent to AI (characters)
MAX_JD_LENGTH=4000

# Session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600

# Webhook configuration for Render Free Web Service
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
TELEGRAM_WEBHOOK_SECRET=your_secret_token_here
